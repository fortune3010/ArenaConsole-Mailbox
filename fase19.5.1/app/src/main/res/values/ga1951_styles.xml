<?xml version="1.0" encoding="utf-8"?>
<!-- GA1951_CALL_UI -->
<resources>
    <style name="Ga1951CallCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
    <!-- o emoji do texto é só o "estado" lido pelo CallScreenFx: fica invisível -->
    <style name="Ga1951CallBtn">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">1sp</item>
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/ga13_call_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Ga1951CallLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#FFCDB8FF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>

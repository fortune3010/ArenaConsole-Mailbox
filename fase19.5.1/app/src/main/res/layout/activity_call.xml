<?xml version="1.0" encoding="utf-8"?>
<!-- GA1951_CALL_UI — ecrã de chamada roxo/neon (referência "pedro1").
     Desenhado só com XML (vector das ondas + shapes). Todos os IDs das fases 13 / 13.5 / 19.5 mantidos:
     callRoot, ga135CallBackdrop, callRemoteView, ga135CallScrim, callInfo, ga135CallAvatarStage, ga135CallRing1..3,
     ga135CallHalo, callAvatar, callName, callStatus, ga135CallSecure, callLocalView, callControls, callMute,
     callSpeaker, callCamera, callHangup, callIncoming, callReject, callAccept.
     Responsivo: coluna vertical com 2 espaços de peso (o centro encolhe; os botões nunca saem do ecrã). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07020F"
    android:keepScreenOn="true">

    <!-- ondas roxo/magenta -->
    <ImageView
        android:id="@+id/ga1951CallWaves"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ga1951_call_waves" />

    <!-- avatar desfocado (Android 12+, CallScreenFx) -->
    <ImageView
        android:id="@+id/ga135CallBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/callRemoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/ga135CallScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ga1951_call_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- topo: ícone + "Chamada recebida" -->
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ga135_call_accept"
            android:tint="#FFD9B8FF" />

        <TextView
            android:id="@+id/ga1951CallTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ga1951_call_incoming"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <!-- centro -->
        <LinearLayout
            android:id="@+id/callInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <FrameLayout
                android:id="@+id/ga135CallAvatarStage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:clipChildren="false">

                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ga1951_call_glow"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/ga135CallRing1"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/ga1951_call_ring_pulse" />

                <View
                    android:id="@+id/ga135CallRing2"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/ga1951_call_ring_pulse" />

                <View
                    android:id="@+id/ga135CallRing3"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/ga1951_call_ring_pulse" />

                <!-- anel neon (o CallScreenFx roda-o) -->
                <View
                    android:id="@+id/ga135CallHalo"
                    android:layout_width="168dp"
                    android:layout_height="168dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ga1951_call_halo" />

                <View
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ga1951_call_avatar_bg"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/callAvatar"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_social_avatar_placeholder" />
            </FrameLayout>

            <TextView
                android:id="@+id/callName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99B44CFF"
                android:shadowRadius="14"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <View
                android:layout_width="140dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ga1951_name_glow"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person_filled"
                    android:tint="#FFCDB8FF" />

                <!-- texto lido pelo CallScreenFx (a chamar / cronómetro / fim) -->
                <TextView
                    android:id="@+id/callStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="A ligar…"
                    android:textColor="#FFCDB8FF"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ga135CallSecure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/ga1951_secure_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ga135_lock"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/ga195_call_encrypted"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <!-- seta ^ -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:rotation="-90"
            android:src="@drawable/ic_chevron_right"
            android:tint="#E6FFFFFF" />

        <!-- rodapé: em curso (callControls) ou a receber (callIncoming), no mesmo lugar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/callControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <LinearLayout style="@style/Ga1951CallCell">
                    <TextView
                        android:id="@+id/callMute"
                        style="@style/Ga1951CallBtn"
                        android:contentDescription="@string/ga195_call_mute"
                        android:drawableTop="@drawable/ga135_sel_call_mic"
                        android:text="🎤" />
                    <TextView style="@style/Ga1951CallLabel" android:text="@string/ga195_call_mute" />
                </LinearLayout>

                <LinearLayout style="@style/Ga1951CallCell">
                    <TextView
                        android:id="@+id/callSpeaker"
                        style="@style/Ga1951CallBtn"
                        android:contentDescription="@string/ga195_call_speaker"
                        android:drawableTop="@drawable/ga135_sel_call_speaker"
                        android:text="🔈" />
                    <TextView style="@style/Ga1951CallLabel" android:text="@string/ga195_call_speaker" />
                </LinearLayout>

                <LinearLayout style="@style/Ga1951CallCell">
                    <TextView
                        android:id="@+id/callCamera"
                        style="@style/Ga1951CallBtn"
                        android:contentDescription="@string/ga195_call_camera"
                        android:drawableTop="@drawable/ga135_sel_call_cam"
                        android:text="📷" />
                    <TextView style="@style/Ga1951CallLabel" android:text="@string/ga195_call_camera" />
                </LinearLayout>

                <LinearLayout style="@style/Ga1951CallCell">
                    <TextView
                        android:id="@+id/callHangup"
                        style="@style/Ga1951CallBtn"
                        android:background="@drawable/ga1951_call_btn_red"
                        android:contentDescription="@string/ga195_call_hangup"
                        android:drawableTop="@drawable/ic_ga135_call_end"
                        android:text="📞" />
                    <TextView
                        style="@style/Ga1951CallLabel"
                        android:text="@string/ga195_call_hangup"
                        android:textColor="#FFFFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callIncoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:visibility="gone">

                <LinearLayout style="@style/Ga1951CallCell">
                    <TextView
                        android:id="@+id/callReject"
                        style="@style/Ga1951CallBtn"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/ga1951_call_btn_red"
                        android:contentDescription="@string/ga195_call_decline"
                        android:drawableTop="@drawable/ic_ga135_call_end"
                        android:text="📞" />
                    <TextView style="@style/Ga1951CallLabel" android:text="@string/ga195_call_decline" />
                </LinearLayout>

                <LinearLayout style="@style/Ga1951CallCell">
                    <TextView
                        android:id="@+id/callAccept"
                        style="@style/Ga1951CallBtn"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/ga135_call_btn_green"
                        android:contentDescription="@string/ga195_call_accept"
                        android:drawableTop="@drawable/ic_ga135_call_accept"
                        android:text="📞" />
                    <TextView style="@style/Ga1951CallLabel" android:text="@string/ga195_call_accept" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- vídeo local (canto, por cima de tudo). Toque = trocar câmara -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/callLocalView"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone" />
</FrameLayout>

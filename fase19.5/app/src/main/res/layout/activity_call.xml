<?xml version="1.0" encoding="utf-8"?>
<!-- GA195_CALL_UI — ecrã de chamada premium v2 (estilo WhatsApp/FaceTime).
     TODOS os IDs e tipos de View das fases 13 / 13.5 preservados (CallActivity + CallScreenFx funcionam sem alterações).
     Mudanças: avatar 150dp com anéis maiores; 4 botões redondos de 64dp com legenda por baixo; textos traduzíveis. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ga135_call_bg"
    android:keepScreenOn="true">

    <!-- avatar desfocado em ecrã inteiro (Android 12+: RenderEffect) -->
    <ImageView
        android:id="@+id/ga135CallBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- auroras néon -->
    <View
        android:id="@+id/ga135CallGlowTop"
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-170dp"
        android:layout_marginTop="-150dp"
        android:background="@drawable/ga135_call_glow_cyan" />

    <View
        android:id="@+id/ga135CallGlowBottom"
        android:layout_width="480dp"
        android:layout_height="480dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-190dp"
        android:layout_marginBottom="-130dp"
        android:background="@drawable/ga135_call_glow_violet" />

    <!-- vídeo remoto (ecrã inteiro) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/callRemoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- véu para ler o texto por cima do vídeo -->
    <View
        android:id="@+id/ga135CallScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ga135_call_scrim" />

    <!-- avatar + anéis + nome + estado (parte de cima do ecrã) -->
    <LinearLayout
        android:id="@+id/callInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:id="@+id/ga135CallAvatarStage"
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:clipChildren="false">

            <View
                android:id="@+id/ga135CallRing1"
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ga135_call_ring" />

            <View
                android:id="@+id/ga135CallRing2"
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ga135_call_ring" />

            <View
                android:id="@+id/ga135CallRing3"
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ga135_call_ring" />

            <View
                android:id="@+id/ga135CallHalo"
                android:layout_width="162dp"
                android:layout_height="162dp"
                android:layout_gravity="center"
                android:background="@drawable/ga135_call_avatar_halo" />

            <ImageView
                android:id="@+id/callAvatar"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_social_avatar_placeholder" />
        </FrameLayout>

        <TextView
            android:id="@+id/callName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowRadius="10"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- o texto do estado é lido pelo CallScreenFx (deteta "a chamar", cronómetro, fim) -->
        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.06"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:text="A ligar…"
            android:textColor="#FF9FC3FF"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/ga135CallSecure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/ga135_secure_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:alpha="0.8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ga135_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/ga195_call_encrypted"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- vídeo local (pequeno, no canto). Toque = trocar câmara -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/callLocalView"
        android:layout_width="108dp"
        android:layout_height="152dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="176dp"
        android:visibility="gone" />

    <!-- dock de vidro: mudo · câmara · altifalante · desligar (64dp + legenda) -->
    <LinearLayout
        android:id="@+id/callControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/ga135_call_dock"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout style="@style/Ga195CallCell">
            <TextView
                android:id="@+id/callMute"
                style="@style/Ga135CallBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/ga195_call_mute"
                android:drawableTop="@drawable/ga135_sel_call_mic"
                android:text="🎤" />
            <TextView style="@style/Ga195CallLabel" android:text="@string/ga195_call_mute" />
        </LinearLayout>

        <LinearLayout style="@style/Ga195CallCell">
            <TextView
                android:id="@+id/callSpeaker"
                style="@style/Ga135CallBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/ga195_call_speaker"
                android:drawableTop="@drawable/ga135_sel_call_speaker"
                android:text="🔈" />
            <TextView style="@style/Ga195CallLabel" android:text="@string/ga195_call_speaker" />
        </LinearLayout>

        <LinearLayout style="@style/Ga195CallCell">
            <TextView
                android:id="@+id/callCamera"
                style="@style/Ga135CallBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/ga195_call_camera"
                android:drawableTop="@drawable/ga135_sel_call_cam"
                android:text="📷" />
            <TextView style="@style/Ga195CallLabel" android:text="@string/ga195_call_camera" />
        </LinearLayout>

        <LinearLayout style="@style/Ga195CallCell">
            <TextView
                android:id="@+id/callHangup"
                style="@style/Ga135CallBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ga135_call_btn_red"
                android:contentDescription="@string/ga195_call_hangup"
                android:drawableTop="@drawable/ic_ga135_call_end"
                android:text="📞" />
            <TextView style="@style/Ga195CallLabel" android:text="@string/ga195_call_hangup" />
        </LinearLayout>
    </LinearLayout>

    <!-- chamada recebida: recusar / atender -->
    <LinearLayout
        android:id="@+id/callIncoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/callReject"
                style="@style/Ga135CallBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/ga135_call_btn_red"
                android:contentDescription="@string/ga195_call_decline"
                android:drawableTop="@drawable/ic_ga135_call_end"
                android:text="📞" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.05"
                android:text="@string/ga195_call_decline"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/callAccept"
                style="@style/Ga135CallBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/ga135_call_btn_green"
                android:contentDescription="@string/ga195_call_accept"
                android:drawableTop="@drawable/ic_ga135_call_accept"
                android:text="📞" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.05"
                android:text="@string/ga195_call_accept"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
